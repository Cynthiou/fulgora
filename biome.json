{
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/*.svg",
      "!client/public",
      "!server/database/seed",
      "!design"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
