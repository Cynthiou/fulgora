# Copy this file to .env and fill in your own values. Never commit .env.
APP_PORT=3310
CLIENT_URL=http://localhost:3000
# Origins allowed to change data, separated by commas (exact match)
ALLOWED_ORIGINS=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=fulgora

# Signs the login token. At least 32 random characters, ex: openssl rand -hex 32
JWT_SECRET=
